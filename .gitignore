# Build output
/spec-guardian
/dist/
*.exe
*.test
*.out

# Reports generated by the tool itself
specguard-report.html
specguard-report.json
specguard-report.txt
*.patch

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.log

# Dependencies
node_modules/
vendor/

# Intentional exceptions: the bad-repo example must contain these files so
# Spec-Guardian can demonstrate its security heuristics.
!examples/bad-repo/.env
!examples/bad-repo/secrets/*.pem
